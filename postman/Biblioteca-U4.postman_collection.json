{
  "info": {
    "name": "Biblioteca U4 - UTEQ",
    "description": "Coleccion base. TODO-U4: complete las carpetas Libros, Socios y Prestamos hasta reunir 20 peticiones como minimo, tal como exige el criterio de verificacion del Paso 2.3 de la Guia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('trae el envoltorio ApiResponse', () => {",
                  "    pm.expect(cuerpo).to.have.all.keys('success','data','message','errors','meta');",
                  "});",
                  "if (cuerpo.data && cuerpo.data.token) { pm.collectionVariables.set('token', cuerpo.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login invalido devuelve 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('title'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"clave-incorrecta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Autores (referencia, ya funciona)",
      "item": [
        {
          "name": "Listar autores paginado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test('meta de paginacion presente', () => pm.expect(c.meta).to.have.property('totalElements'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autores?page=0&size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autores"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Autor inexistente devuelve 404 ProblemDetail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('trae title y status', () => {",
                  "    const c = pm.response.json();",
                  "    pm.expect(c).to.have.property('title');",
                  "    pm.expect(c.status).to.eql(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autores/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autores",
                "999999"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Libros (TODO-U4-1)",
      "item": []
    },
    {
      "name": "Socios (TODO-U4-1)",
      "item": []
    },
    {
      "name": "Prestamos (TODO-U4-1)",
      "item": []
    },
    {
      "name": "API externa (TODO-U4-4)",
      "item": []
    }
  ]
}