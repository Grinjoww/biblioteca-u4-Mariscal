# Copie este archivo a .env y complete los valores.
# El archivo .env NUNCA se versiona: ya esta en .gitignore.

DB_NAME=biblioteca
DB_USER=biblioteca
DB_PASSWORD=cambieme

# Genere el secreto con:  openssl rand -base64 48
# Debe decodificar a 32 bytes o mas para poder firmar con HS256.
JWT_SECRETO=
JWT_EXPIRACION_MINUTOS=60

API_EXTERNA_URL=https://openlibrary.org
